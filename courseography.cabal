cabal-version:       3.0
name:                courseography
version:             0.8.1.0
synopsis:            Program and course planning app for the University of Toronto.
description:         A web application designed to aid students in planning their courses
                     at the University of Toronto.
homepage:            https://courseography.teach.cs.toronto.edu
license:             GPL-3.0-or-later
license-file:        LICENSE
author:              David Liu
maintainer:          david@cs.toronto.edu
-- copyright:
category:            Planning
build-type:          Custom

custom-setup
  setup-depends:
    base >= 4.14,
    Cabal >= 3.0,
    process >= 1.2,
    directory

common shared
  default-extensions:
    LambdaCase,
    OverloadedStrings,
    ScopedTypeVariables
  default-language: Haskell2010
  ghc-options: -Wall -fwarn-tabs

library
  import: shared
  hs-source-dirs: app
  exposed-modules:
    Config,
    Controllers.Course,
    Controllers.Generate,
    Controllers.Graph,
    Controllers.Program,
    Controllers.Timetable,
    Css.Constants,
    Database.CourseVideoSeed,
    Database.Database,
    Database.DataType,
    Database.Migrations,
    Database.Requirement,
    Database.Tables,
    DynamicGraphs.CourseFinder,
    DynamicGraphs.GraphGenerator,
    DynamicGraphs.GraphNodeUtils,
    DynamicGraphs.GraphOptions,
    DynamicGraphs.WriteRunDot,
    Export.GetImages,
    Export.ImageConversion,
    Export.LatexGenerator,
    Export.PdfGenerator,
    Export.TimetableImageCreator,
    MasterTemplate,
    Models.Building,
    Models.Course,
    Models.Graph,
    Models.Meeting,
    Models.Program,
    Models.Requirement,
    Models.Time,
    Response,
    Response.About,
    Response.Loading,
    Response.NotFound,
    Routes,
    Scripts,
    Server,
    Svg.Builder,
    Svg.Generator,
    Svg.Parser,
    Util.Blaze,
    Util.Documentation,
    Util.Happstack,
    Util.Helpers,
    Util.Matrix,
    WebParsing.ArtSciParser,
    WebParsing.Ligature,
    WebParsing.ParsecCombinators,
    WebParsing.PostParser,
    WebParsing.ReqParser,
    WebParsing.UtsgJsonParser
  build-depends:
    aeson,
    base >=4.14,
    base64-bytestring,
    blaze-html,
    blaze-markup,
    blaze-svg,
    bytestring,
    Cabal >= 1.16.0,
    containers,
    crypton-connection,
    data-default-class,
    directory,
    diagrams-lib,
    diagrams-svg,
    filepath,
    graphviz,
    HaTeX,
    happstack-server,
    hslogger,
    http-conduit,
    http-types,
    MissingH,
    markdown,
    monad-logger,
    mtl,
    parsec,
    persistent,
    persistent-sqlite,
    process,
    random,
    resourcet,
    split,
    svg-builder,
    system-filepath,
    tagsoup,
    temporary,
    text,
    text-show,
    time,
    tls,
    transformers,
    unordered-containers,
    yaml

test-suite Tests
  import: shared
  main-is: Main.hs
  other-modules:
    Controllers.CourseControllerTests,
    Controllers.GenerateControllerTests,
    Controllers.GraphControllerTests,
    Controllers.ProgramControllerTests,
    Database.BuildingTests,
    Database.CourseQueriesTests,
    Database.DatabaseTests,
    Models.MeetingTests,
    Models.RequirementModelTests,
    RequirementTests.ModifierTests,
    RequirementTests.PostParserTests,
    RequirementTests.PreProcessingTests,
    RequirementTests.FilterReqTests,
    SvgTests.IntersectionTests,
    TestHelpers,
    WebParsing.ArtSciParserTests,
    WebParsing.UtsgJsonParserTests
  type: exitcode-stdio-1.0
  build-depends:
    aeson,
    base >=4.14,
    bytestring,
    Cabal >= 1.16.0,
    containers,
    courseography,
    directory,
    happstack-server,
    parsec,
    persistent-sqlite,
    QuickCheck,
    split,
    tagsoup,
    tasty >=1.5.3,
    tasty-discover,
    tasty-hunit,
    test-framework,
    test-framework-hunit,
    test-framework-quickcheck2,
    text,
    time
  build-tool-depends:
    tasty-discover:tasty-discover
  hs-source-dirs: backend-test

executable courseography
  import: shared
  hs-source-dirs: exe
  main-is: Main.hs
  build-depends:
    base >=4.14,
    containers,
    courseography,
    graphviz
